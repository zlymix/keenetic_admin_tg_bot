telegram:
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
  # User IDs allowed to access the bot (find via @userinfobot)
  allowed_users:
    - 123456789
  # Chat ID to send device connect/disconnect notifications (can be user ID or group ID like -100xxxxxxxxxx)
  notification_chat_id: 123456789

router:
  url: "http://192.168.1.1"
  login: "admin"
  password: "tmpPASS123"
  poll_interval_seconds: 15

storage:
  favorites_file: "data/favorites.json"
  history_file: "data/history.json"
